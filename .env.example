# Secret untuk menandatangani cookie sesi (WAJIB di produksi)
# Buat dengan: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-byte-secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# CartoDB API Key for map tiles
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# App Version
NEXT_PUBLIC_APP_VERSION=v1.1.0

# URL publik aplikasi (dipakai untuk preview Open Graph saat link dibagikan)
# Contoh: https://simira.domain-anda.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
